# Copy to .env.local and supply your intentionally selected local/test project.
# This template contains no project URL or real key.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel: set the three variables per target environment before any future build.
# NEXT_PUBLIC_APP_ENV=preview for Preview; production for Production.
# VERCEL_ENV is supplied by Vercel, not configured here.
# Never place sb_secret_*, service_role or user access tokens in NEXT_PUBLIC_*.

# Server-only invitations: enable only after the real invite email template uses
# supabase/templates/invite.html and SMTP/redirects have been verified in that environment.
# Leave unset while email delivery is unavailable. Never use a NEXT_PUBLIC_ prefix.
AUTH_INVITE_TEMPLATE_MODE=
# NEXT_PUBLIC_SITE_URL must be that environment's reviewed app origin, without a path/query.
NEXT_PUBLIC_SITE_URL=
